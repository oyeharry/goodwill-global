---
import SectionHeading from '@/components/SectionHeading.astro';
import { about, statements } from '@/data/content';
---

<section id="about" class="section">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="Who we are" title={about.title} />
        <div class="mt-6 space-y-4 text-lg text-ink/75">
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div id="vision" class="space-y-5">
        {
          statements.map((statement) => (
            <article class="card border-l-4 border-l-accent-500">
              <h3 class="text-xs font-semibold tracking-[0.2em] text-brand-700 uppercase">{statement.label}</h3>
              <p class="mt-3 font-display text-xl leading-snug text-brand-950">{statement.text}</p>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{statement.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
