---
import SectionHeading from '@/components/SectionHeading.astro';
import { about, mission, values, vision } from '@/data/content';

const statements = [
  { label: 'Our vision', text: vision },
  { label: 'Our mission', text: mission },
];
---

<section id="about" class="section">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="About us" title={about.title} />
        <div class="mt-6 space-y-4 text-lg text-ink/75">
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="space-y-5">
        {
          statements.map((statement) => (
            <figure class="card border-l-4 border-l-accent-500">
              <figcaption class="text-xs font-semibold tracking-[0.2em] text-brand-700 uppercase">
                {statement.label}
              </figcaption>
              <blockquote class="mt-3 font-display text-xl leading-snug text-brand-950 sm:text-2xl">
                {statement.text}
              </blockquote>
            </figure>
          ))
        }
      </div>
    </div>

    <dl id="values" class="mt-20 grid gap-x-8 gap-y-8 border-t border-brand-900/10 pt-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value) => (
          <div>
            <dt class="font-display text-xl font-semibold text-brand-900">{value.title}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-ink/70">{value.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
