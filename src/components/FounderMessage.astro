---
import Portrait from '@/components/Portrait.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { founderMessage } from '@/data/content';
import { founder } from '@/data/leadership';
import { site } from '@/data/site';
---

<section id="founder" class="section bg-brand-50">
  <div class="container-page grid items-start gap-12 lg:grid-cols-[20rem_1fr] lg:gap-16">
    <figure class="mx-auto w-full max-w-xs lg:sticky lg:top-32">
      <Portrait person={founder} size={640} class="aspect-[5/6] rounded-3xl shadow-xl" />
      <figcaption class="mt-5">
        <p class="font-display text-xl font-semibold text-brand-950">{founder.name}</p>
        <p class="text-sm text-ink/70">{founder.role}, {site.name}</p>
      </figcaption>
    </figure>

    <div>
      <SectionHeading eyebrow="From the founder's desk" title={founderMessage.title} />
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink/75">
        {founderMessage.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="mt-8 border-l-4 border-accent-500 pl-5 font-display text-xl leading-snug text-brand-900 sm:text-2xl">
        {founderMessage.closing}
      </p>
      <p class="mt-8 text-sm text-ink/70">
        Warm regards,<br />
        <span class="font-display text-lg font-semibold text-brand-950">{founder.name}</span>
      </p>
    </div>
  </div>
</section>
