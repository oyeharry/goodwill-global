---
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getInvolved } from '@/data/content';
import { site } from '@/data/site';

const { address } = site;
---

<section id="get-involved" class="section">
  <div class="container-page">
    <div class="grid gap-10 rounded-[2rem] bg-brand-950 p-6 sm:p-14 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0">
        <SectionHeading light eyebrow="Get involved" title={getInvolved.title} lead={getInvolved.lead} />
        <ul class="mt-8 flex flex-wrap gap-2 text-sm font-medium text-white">
          {
            ['Partner', 'Volunteer', 'Donate'].map((way) => (
              <li class="rounded-full border border-white/20 px-4 py-1.5">{way}</li>
            ))
          }
        </ul>
      </div>

      <address id="contact" class="min-w-0 space-y-4 rounded-3xl bg-white/5 p-6 text-white not-italic sm:p-9">
        <h3 class="font-display text-2xl font-semibold">Contact us</h3>

        <div class="flex gap-4">
          <Icon name="pin" class="mt-0.5 h-6 w-6 shrink-0 text-accent-400" />
          <p class="text-white/80">
            {address.street}<br />
            {address.city}, {address.region} {address.postalCode}<br />
            {address.country}
          </p>
        </div>

        {
          site.phone && (
            <div class="flex items-center gap-4">
              <Icon name="phone" class="h-6 w-6 shrink-0 text-accent-400" />
              <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="py-2.5 text-white/80 hover:text-white">
                {site.phone}
              </a>
            </div>
          )
        }

        {
          site.email && (
            <div class="flex items-center gap-4">
              <Icon name="mail" class="h-6 w-6 shrink-0 text-accent-400" />
              <a href={`mailto:${site.email}`} class="min-w-0 py-2.5 break-all text-white/80 hover:text-white">
                {site.email}
              </a>
            </div>
          )
        }
      </address>
    </div>
  </div>
</section>
