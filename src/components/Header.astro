---
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import { navigation } from '@/data/site';
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-5">
  <div
    class="mx-auto max-w-6xl rounded-2xl border border-brand-900/10 bg-white/95 shadow-lg shadow-brand-950/10 backdrop-blur"
  >
    <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <Logo />

      <nav class="hidden lg:block" aria-label="Main">
        <ul class="flex items-center gap-1">
          {
            navigation.map((item) => (
              <li class="group relative">
                <a
                  href={item.href}
                  class="flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium text-brand-950 hover:bg-brand-50"
                >
                  {item.label}
                  {item.children && (
                    <Icon name="chevron" class="h-4 w-4 transition group-hover:rotate-180" />
                  )}
                </a>
                {item.children && (
                  <div class="invisible absolute top-full left-0 pt-3 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                    <ul class="w-56 rounded-2xl border border-brand-900/10 bg-white p-2 shadow-xl">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="block rounded-xl px-4 py-2.5 text-sm text-brand-950 hover:bg-brand-50"
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href="#get-involved" class="btn btn-primary hidden sm:inline-flex">Get involved</a>
        <button
          type="button"
          id="menu-toggle"
          class="rounded-full p-2 text-brand-950 hover:bg-brand-50 lg:hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle menu"
        >
          <Icon name="menu" />
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="hidden border-t border-brand-900/10 px-4 py-4 lg:hidden" aria-label="Mobile">
      <ul class="max-h-[70vh] space-y-4 overflow-y-auto">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} class="block font-semibold text-brand-950">
                {item.label}
              </a>
              {item.children && (
                <ul class="mt-2 space-y-2 border-l border-brand-200 pl-4">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block text-sm text-ink/75">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li><a href="#get-involved" class="btn btn-primary w-full">Get involved</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
