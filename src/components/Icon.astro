---
import type { IconName } from '@/data/content';

interface Props {
  name: IconName | 'chevron' | 'menu' | 'close' | 'pin' | 'phone' | 'mail' | 'arrow' | 'check';
  class?: string;
}

/** Stroke-based 24×24 icon paths. */
const paths: Record<Props['name'], string> = {
  hands: 'M3 13l4-1 5 2.500h4a1.500 1.500 0 0 1 0 3h-4m4-1.500 4-2a1.600 1.600 0 0 1 1.500 2.800L15 20.500 3 18v-5Zm9-3.500s-4-2.400-4-5.200A2.300 2.300 0 0 1 12 3a2.300 2.300 0 0 1 4 1.300c0 2.800-4 5.200-4 5.200Z',
  education: 'M3 9l9-5 9 5-9 5-9-5Zm4 2.500V16c1.500 1.300 3.200 2 5 2s3.500-.700 5-2v-4.500M21 9v6',
  health: 'M12 20s-7.500-4.600-7.500-10A4.300 4.300 0 0 1 12 7a4.300 4.300 0 0 1 7.500 3c0 5.400-7.500 10-7.500 10ZM12 10v4m-2-2h4',
  home: 'M4 11l8-7 8 7v9H4v-9Zm8 6.500s-3-1.800-3-3.800a1.700 1.700 0 0 1 3-1 1.700 1.700 0 0 1 3 1c0 2-3 3.800-3 3.800Z',
  leaf: 'M12 21V10m0 0c0-3.300 2.200-6 6-6 0 3.800-2.700 6-6 6Zm0 4c0-2.800-1.900-5-5-5 0 3.200 2.200 5 5 5ZM5 21h14',
  trophy: 'M8 4h8v5a4 4 0 0 1-8 0V4Zm0 2H5a3 3 0 0 0 3 3m8-3h3a3 3 0 0 1-3 3m-4 4v4m-3 3h6',
  book: 'M12 6c-2-1.500-4.500-2-8-2v14c3.500 0 6 .500 8 2 2-1.500 4.500-2 8-2V4c-3.500 0-6 .500-8 2Zm0 0v14',
  check: 'M5 12.500l4.500 4.500L19 7.500',
  chevron: 'M6 9l6 6 6-6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  pin: 'M12 21s7-6.200 7-11.500a7 7 0 1 0-14 0C5 14.800 12 21 12 21Zm0-9a2.500 2.500 0 1 0 0-5 2.500 2.500 0 0 0 0 5Z',
  phone: 'M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z',
  mail: 'M3 6h18v12H3V6Zm0 0 9 7 9-7',
  arrow: 'M5 12h14m-6-6 6 6-6 6',
};

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.600"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
