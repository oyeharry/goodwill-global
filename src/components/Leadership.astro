---
import PersonCard from '@/components/PersonCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { leadership } from '@/data/content';
import { boardOfDirectors, officeBearers } from '@/data/leadership';
import { initials } from '@/utils/paths';

const groupTitle = 'flex items-center gap-4 text-sm font-semibold tracking-[0.2em] text-brand-700 uppercase';
---

<section id="leadership" class="section">
  <div class="container-page">
    <SectionHeading
      eyebrow="Leadership"
      title={leadership.title}
      lead={leadership.boardIntro}
    />

    <div id="board" class="mt-14">
      <h3 class={groupTitle}>
        Board of Directors
        <span class="h-px flex-1 bg-brand-900/10"></span>
      </h3>
      <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-5">
        {boardOfDirectors.map((person) => <PersonCard person={person} />)}
      </ul>
    </div>

    <div id="office-bearers" class="mt-14">
      <h3 class={groupTitle}>
        Office bearers
        <span class="h-px flex-1 bg-brand-900/10"></span>
      </h3>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 sm:gap-5">
        {
          officeBearers.map((person) => (
            <li class="flex items-center gap-5 rounded-3xl border border-brand-900/10 bg-white p-5 shadow-sm sm:p-6">
              <span
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-brand-700 to-brand-950 font-display text-lg font-semibold text-white"
                aria-hidden="true"
              >
                {initials(person.name)}
              </span>
              <div>
                <p class="text-xs font-semibold tracking-[0.2em] text-accent-700 uppercase">{person.role}</p>
                <h4 class="mt-1 font-display text-xl font-semibold text-brand-950">{person.name}</h4>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div id="members" class="mt-14 rounded-3xl bg-brand-50 p-7 sm:p-10">
      <h3 class="font-display text-2xl font-semibold text-brand-950">{leadership.members.title}</h3>
      <div class="mt-4 max-w-3xl space-y-3 text-ink/75">
        {leadership.members.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>

<script>
  // Native <dialog> wiring for the "Read vision" pop-ups.
  document.querySelectorAll<HTMLElement>('[data-dialog-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.dialogOpen ?? '') as HTMLDialogElement | null;
    button.addEventListener('click', () => dialog?.showModal());
  });

  document.querySelectorAll('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      // Close on the close button or a click on the backdrop.
      if (target === dialog || target.closest('[data-dialog-close]')) dialog.close();
    });
  });
</script>
