---
import PersonCard from '@/components/PersonCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { boardOfDirectors, officeBearers } from '@/data/leadership';

const groups = [
  { id: 'board', title: 'Board of Directors', people: boardOfDirectors },
  { id: 'office-bearers', title: 'Office bearers', people: officeBearers },
];
---

<section id="leadership" class="section">
  <div class="container-page">
    <SectionHeading
      eyebrow="Leadership"
      title="The people behind the purpose."
      lead="A team united by one belief: that service to others is the highest responsibility."
    />

    {
      groups.map((group) => (
        <div id={group.id} class="mt-14">
          <h3 class="flex items-center gap-4 text-sm font-semibold tracking-[0.2em] text-brand-700 uppercase">
            {group.title}
            <span class="h-px flex-1 bg-brand-900/10" />
          </h3>
          <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-5">
            {group.people.map((person) => (
              <PersonCard person={person} />
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Native <dialog> wiring for the "Read vision" pop-ups.
  document.querySelectorAll<HTMLElement>('[data-dialog-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.dialogOpen ?? '') as HTMLDialogElement | null;
    button.addEventListener('click', () => dialog?.showModal());
  });

  document.querySelectorAll('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      // Close on the close button or a click on the backdrop.
      if (target === dialog || target.closest('[data-dialog-close]')) dialog.close();
    });
  });
</script>
