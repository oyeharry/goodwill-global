---
import { site } from '@/data/site';

interface Props {
  /** Use on dark backgrounds. */
  light?: boolean;
}

const { light = false } = Astro.props;
---

<a href="#top" class="flex items-center gap-3" aria-label={`${site.name} — home`}>
  <svg viewBox="0 0 48 48" class="h-10 w-10 shrink-0" aria-hidden="true">
    <circle cx="24" cy="24" r="22" class={light ? 'fill-white/10' : 'fill-brand-800'}></circle>
    <path
      d="M24 4a20 20 0 0 1 0 40M24 4a20 20 0 0 0 0 40M4 24h40"
      fill="none"
      stroke-width="1.5"
      class={light ? 'stroke-white/30' : 'stroke-white/25'}></path>
    <path
      d="M24 34.5s-9-5.6-9-12a5.2 5.2 0 0 1 9-3.5 5.2 5.2 0 0 1 9 3.5c0 6.400-9 12-9 12Z"
      class="fill-accent-400"></path>
  </svg>
  <span class="leading-tight">
    <span class:list={['block font-display text-lg font-semibold', light ? 'text-white' : 'text-brand-900']}>
      Goodwill Global
    </span>
    <span
      class:list={[
        'block text-[0.65rem] font-semibold tracking-[0.25em] uppercase',
        light ? 'text-white/60' : 'text-brand-700',
      ]}
    >
      Foundation
    </span>
  </span>
</a>
