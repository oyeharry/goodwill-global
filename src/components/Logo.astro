---
import { site } from '@/data/site';
import { withBase } from '@/utils/paths';

interface Props {
  /** Use on dark backgrounds. */
  light?: boolean;
}

const { light = false } = Astro.props;
---

<a href="#top" class="flex items-center gap-3">
  <img
    src={withBase(light ? 'logo-mark-light.svg' : 'logo-mark.svg')}
    alt=""
    width="1170"
    height="813"
    class="h-11 w-auto shrink-0 sm:h-12"
  />
  <span class="leading-none">
    <span
      class:list={[
        'block font-display text-xl font-semibold tracking-wide uppercase sm:text-2xl',
        light ? 'text-white' : 'text-brand-900',
      ]}
    >
      Goodwill
    </span>
    <span
      class:list={[
        'mt-1 block text-[0.6rem] font-semibold tracking-[0.2em] uppercase sm:text-[0.65rem]',
        light ? 'text-accent-300' : 'text-accent-700',
      ]}
    >
      Global Foundation
    </span>
  </span>
  <span class="sr-only">{site.name} — home</span>
</a>
