---
import Portrait from '@/components/Portrait.astro';
import type { Person } from '@/data/leadership';

interface Props {
  person: Person;
}

const { person } = Astro.props;
---

<li class="overflow-hidden rounded-3xl border border-brand-900/10 bg-white shadow-sm">
  <Portrait person={person} class="aspect-[5/6]" />
  <div class="p-5">
    <h4 class="font-display text-lg leading-snug font-semibold text-brand-950">{person.name}</h4>
    <p class="mt-1 text-sm text-accent-600">{person.role}</p>
  </div>
</li>
