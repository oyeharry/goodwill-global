---
import Icon from '@/components/Icon.astro';
import Portrait from '@/components/Portrait.astro';
import VisionDialog from '@/components/VisionDialog.astro';
import type { Person } from '@/data/leadership';

interface Props {
  person: Person;
}

const { person } = Astro.props;
---

<li class="flex flex-col overflow-hidden rounded-3xl border border-brand-900/10 bg-white shadow-sm">
  <Portrait
    person={person}
    size={320}
    sizes="(min-width: 1024px) 210px, (min-width: 640px) 30vw, 45vw"
    class="aspect-[5/6]"
  />
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <h4 class="font-display text-base leading-snug font-semibold break-words text-brand-950 sm:text-lg">{person.name}</h4>
    <p class="mt-1 text-sm text-accent-700">{person.role}</p>
    {person.profession && <p class="mt-1 text-xs text-ink/60">{person.profession}</p>}
    {
      person.vision && (
        <button
          type="button"
          data-dialog-open={`vision-${person.slug}`}
          class="mt-auto inline-flex min-h-11 cursor-pointer items-end gap-1.5 pt-3 text-sm font-semibold text-brand-700 hover:text-brand-900"
        >
          Read vision <Icon name="arrow" class="h-4 w-4" />
        </button>
      )
    }
  </div>
  {person.vision && <VisionDialog person={person} />}
</li>
