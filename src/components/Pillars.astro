---
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { pillars } from '@/data/content';
---

<section id="pillars" class="section bg-brand-950">
  <div class="container-page">
    <SectionHeading
      light
      eyebrow="What we do"
      title="Four pillars. One purpose."
      lead="Our roadmap is built on four foundations that turn compassion into lasting change."
    />

    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((pillar, index) => (
          <li class="rounded-3xl border border-white/10 bg-white/5 p-7 transition hover:bg-white/10">
            <div class="flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent-500 text-brand-950">
                <Icon name={pillar.icon} />
              </span>
              <span class="font-display text-3xl text-white/20">0{index + 1}</span>
            </div>
            <h3 class="mt-6 font-display text-xl font-semibold text-white">{pillar.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/70">{pillar.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
