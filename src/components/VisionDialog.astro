---
import Icon from '@/components/Icon.astro';
import Portrait from '@/components/Portrait.astro';
import type { Person } from '@/data/leadership';

interface Props {
  person: Person;
}

const { person } = Astro.props;
const id = `vision-${person.slug}`;
---

{
  person.vision && (
    <dialog
      id={id}
      aria-labelledby={`${id}-title`}
      class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-3xl bg-white p-0 text-ink shadow-2xl backdrop:bg-brand-950/70 backdrop:backdrop-blur-sm"
    >
      <div class="max-h-[85vh] overflow-y-auto p-7 sm:p-10">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-4">
            <Portrait person={person} size={64} class="h-16 w-16 shrink-0 rounded-full [&_span]:text-xl" />
            <div>
              <p class="text-xs font-semibold tracking-[0.2em] text-accent-700 uppercase">My vision</p>
              <h3 id={`${id}-title`} class="font-display text-2xl font-semibold text-brand-950">
                {person.name}
              </h3>
              <p class="text-sm text-ink/60">
                {[person.role, person.profession].filter(Boolean).join(' · ')}
              </p>
            </div>
          </div>
          <button
            type="button"
            data-dialog-close
            aria-label="Close"
            class="cursor-pointer rounded-full p-2 text-brand-950 hover:bg-brand-50"
          >
            <Icon name="close" />
          </button>
        </div>

        <blockquote class="mt-7 border-l-4 border-accent-500 pl-5 font-display text-xl leading-snug text-brand-900">
          {person.vision.quote}
        </blockquote>
        <div class="mt-6 space-y-4 leading-relaxed text-ink/75">
          {person.vision.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </dialog>
  )
}
